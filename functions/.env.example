# Copy to functions/.env (git-ignored) to override defaults per Firebase project.
# The ingest credential itself stays in Secret Manager as DYNATRACE_PLATFORM_TOKEN.
DYNATRACE_ENDPOINT=https://indiacs.live.dynatrace.com
PUBLIC_BASE_URL=https://inspiredlearning-vh.web.app
# Preserve both by default. Use platform only after confirming the GCP log forwarder,
# or otlp only after confirming OTLP visibility. Pre-initialization logs keep console fallback.
TELEMETRY_LOG_SINK=both
