{
  "name": "inspiredlearning",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src test scripts",
    "test": "node --test test/model.test.mjs test/api.test.mjs test/certificate-policy.test.mjs test/telemetry-policy.test.mjs",
    "test:browser": "playwright test",
    "test:rehearsal": "node scripts/rehearsal.mjs",
    "test:integration": "firebase emulators:exec --config firebase.rehearsal.json --project demo-chaicart --only firestore \"node --test --test-concurrency=1 test/integration.test.mjs test/outbox.test.mjs\"",
    "test:swagger": "node --test test/swagger.test.mjs",
    "test:api-auth": "firebase emulators:exec --config firebase.rehearsal.json --project demo-chaicart --only auth,firestore \"node --test test/api-auth.test.mjs\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "firebase": "^12.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "firebase-tools": "15.34.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
